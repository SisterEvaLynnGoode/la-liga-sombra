      "type": "sentenceBuilder",
      "sentences": [
        {
          "sentence": "El sitio era tranquilo por la mañana.",
          "translation": "The site was quiet in the morning."
        },
        {
          "sentence": "Había turistas solo los domingos.",
          "translation": "There were tourists only on Sundays."
        },
        {
          "sentence": "Ella iba al mercado cada día.",
          "translation": "She went to the market every day."
        },
        {
          "sentence": "Los guardias tenían una rutina fija.",
          "translation": "The guards had a fixed routine."
        },
        {
          "sentence": "Todos los días veía las mismas piedras.",
          "translation": "Every day she saw the same stones."
        }
      ]
    },
    {
      "type": "readingComp",
      "passage": "Antes del robo, el sitio era muy tranquilo. Por la mañana no había casi nadie. Los trabajadores llegaban a las siete y limpiaban el camino de piedra. Doña Aurora iba cada día al mercado y volvía a las once con pan y fruta para todos. Los guardias tenían una rutina fija: uno estaba arriba y el otro abajo, siempre. Nadie tocaba las piedras. Todo el mundo sabía cuál era su sitio, y por eso nadie miraba dos veces.",
      "glossary": [
        {
          "word": "tranquilo",
          "translation": "quiet"
        },
        {
          "word": "el camino",
          "translation": "the path"
        },
        {
          "word": "volvía",
          "translation": "she used to return"
        },
        {
          "word": "la rutina",
          "translation": "the routine"
        },
        {
          "word": "fija",
          "translation": "fixed"
        },
        {
