        {
          "sentence": "El público miraba cuando se apagó la luz.",
          "translation": "The audience was watching when the light went out."
        },
        {
          "sentence": "De repente gritó una mujer.",
          "translation": "Suddenly a woman shouted."
        },
        {
          "sentence": "Todos aplaudían y nadie miró la puerta.",
          "translation": "Everyone was clapping and nobody looked at the door."
        },
        {
          "sentence": "Cuando terminó la canción, el trofeo ya no estaba.",
          "translation": "When the song ended, the trophy was gone."
        }
      ]
